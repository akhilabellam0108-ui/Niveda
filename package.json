{
  "name": "niveda",
  "version": "0.1.0",
  "description": "Privacy-first, patient-controlled lifelong health record (prototype)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "admin": "tsx --tsconfig server/tsconfig.json server/src/admin.ts",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "test": "cross-env NODE_ENV=test tsx --tsconfig server/tsconfig.json --test server/test/api.test.ts",
    "test:e2e": "python3 tests/e2e_browser.py"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@node-rs/argon2": "^2.2.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.48.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true,
  "type": "module"
}
