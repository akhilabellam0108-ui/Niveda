{
  "name": "niveda",
  "version": "0.1.0",
  "description": "Privacy-first, patient-controlled lifelong health record (prototype)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "test:db": "node --test --test-concurrency=1 tests/db/backend.test.mjs",
    "gen:record-types": "node scripts/gen-record-types.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "pg": "^8.23.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true,
  "type": "module"
