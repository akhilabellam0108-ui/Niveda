{
  "name": "niveda",
  "version": "0.1.0",
  "description": "Privacy-first, patient-controlled lifelong health record (prototype)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "test:db": "node --test --test-concurrency=1 tests/db/backend.test.mjs",
    "gen:record-types": "node scripts/gen-record-types.mjs",
    "test:live": "node --test --test-concurrency=1 tests/live/live.test.mjs",
    "create-doctor": "node scripts/create-doctor.mjs",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "pg": "^8.23.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "web-push": "^3.6.7"
  },
  "private": true,
  "type": "module"
}
