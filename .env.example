# Copy to .env.local and fill in to run the app against your Supabase project.
# Leave both empty to use the built-in demo with fictional data.
# Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only for scripts/create-doctor.mjs, run on your own machine. Never commit it,
# and never put it in a VITE_ variable (those are bundled into the app).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
