# ---------- Required in production ----------
NODE_ENV=production
APP_URL=https://your-domain.example          # public HTTPS address of the app
DATABASE_URL=postgres://user:pass@host:5432/niveda
DATABASE_SSL=false                           # true for most hosted Postgres (Render, Neon, Supabase)
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENCRYPTION_KEY=
OTP_PEPPER=
COOKIE_SECURE=true
TRUST_PROXY=true

# ---------- One-time codes ----------
OTP_CHANNEL=email                            # email | sms
OTP_DEV_ECHO=false                           # NEVER true in production
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Niveda <no-reply@your-domain.example>"
# SMS (optional, when OTP_CHANNEL=sms)
SMS_PROVIDER=                                # twilio | msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---------- Medicine reminder push notifications ----------
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.example

# ---------- Optional ----------
PORT=8080
SESSION_HOURS=12
SEED_DEMO=false                              # true loads fictional demo accounts
DATA_DIR=/data                               # uploaded (encrypted) files live here — use a persistent disk
